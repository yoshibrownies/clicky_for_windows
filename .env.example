# Your deployed Cloudflare Worker (see README). No API keys go in this file.
CLICKY_WORKER_URL=https://clicky-proxy.your-subdomain.workers.dev

# Hold-to-talk keys joined with "+". Names: ctrl, alt, shift, win, left_ctrl, right_ctrl,
# left_alt, right_alt, left_shift, right_shift, f13 ... f24
CLICKY_HOTKEY=ctrl+alt

# Claude: claude-opus-5-5 (default) or claude-sonnet-5-5 (about half the price).
# OpenAI (needs the OPENAI_API_KEY Worker secret): gpt-6.1-terra or gpt-6-luna (cheapest).
# Also switchable from the tray menu.
CLICKY_MODEL=claude-opus-5-5

# low (fastest replies) | medium (default, smarter) | high. Also switchable from the tray ("Thinking").
CLICKY_EFFORT=medium
